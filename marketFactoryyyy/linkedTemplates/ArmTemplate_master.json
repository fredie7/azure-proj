{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "marketFactoryyyy"
		},
		"linkedServiceDB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'linkedServiceDB'"
		},
		"linkedSource_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'linkedSource'"
		},
		"linkedServiceDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "markerdbserver.database.windows.net"
		},
		"linkedServiceDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "marketDB"
		},
		"linkedServiceDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "fredie"
		},
		"linkedSource_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://marketstorage1111.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "marketFactoryyyy_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"linkedServiceDB_password": {
						"value": "[parameters('linkedServiceDB_password')]"
					},
					"linkedSource_accountKey": {
						"value": "[parameters('linkedSource_accountKey')]"
					},
					"linkedServiceDB_properties_typeProperties_server": {
						"value": "[parameters('linkedServiceDB_properties_typeProperties_server')]"
					},
					"linkedServiceDB_properties_typeProperties_database": {
						"value": "[parameters('linkedServiceDB_properties_typeProperties_database')]"
					},
					"linkedServiceDB_properties_typeProperties_userName": {
						"value": "[parameters('linkedServiceDB_properties_typeProperties_userName')]"
					},
					"linkedSource_properties_typeProperties_url": {
						"value": "[parameters('linkedSource_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}